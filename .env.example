# ---------------------------------------------------------
# MasterQ Deployment Environment Variables
# ---------------------------------------------------------

# PostgreSQL Database Configuration
# Format: postgresql+asyncpg://user:pass@host:port/dbname
DATABASE_URL=postgresql+asyncpg://user:pass@postgres:5432/qgendb

# Redis Configuration (Cache & Rate Limiting)
REDIS_URL=redis://redis:6379/0

# Celery Broker URL (Using a separate Redis DB index)
CELERY_BROKER_URL=redis://redis:6379/1

# ---------------------------------------------------------
# Artificial Intelligence Configuration
# ---------------------------------------------------------
# Your Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL_NAME=gemini-2.5-pro
EMBEDDING_MODEL_NAME=models/text-embedding-004

# Concurrency limits for asyncio semaphores
LLM_SEMAPHORE_LIMIT=5
EMBEDDING_SEMAPHORE_LIMIT=10

# ---------------------------------------------------------
# Object Storage (MinIO / S3)
# ---------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_ADMIN=admin-documents
MINIO_BUCKET_USER=user-documents

# ---------------------------------------------------------
# Authentication & Security
# ---------------------------------------------------------
# Secret key used for JWT signing (Change this in production!)
JWT_SECRET_KEY=your_jwt_secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
